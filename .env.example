# Copie para .env.local e preencha com os dados do projeto Supabase
# (Project Settings → API). Sem essas variáveis, o app roda no modo demonstração.
# São chaves públicas: a segurança vem das políticas RLS do banco.
# NUNCA coloque aqui a service_role/secret key.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
